{
  "name": "iis-lab1-currency",
  "version": "1.0.0",
  "private": true,
  "description": "Учебный конвертер: вариант 3, курсы фиксированные и демонстрационные",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "lint": "eslint src tests scripts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "build": "node scripts/build.js",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {"eslint": "^9.0.0", "jest": "^30.0.0"},
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "json-summary", "lcov", "html"],
    "coverageThreshold": {"global": {"lines": 80, "functions": 80, "statements": 80}}
  }
}
